# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENWEATHER_API_KEY: OpenWeatherMap API key (https://openweathermap.org/api).
# When configured in Secrets or .env, the server proxies requests through OpenWeatherMap.
OPENWEATHER_API_KEY=""

# WEATHERAPI_KEY: WeatherAPI.com API key (https://www.weatherapi.com/).
# Alternative weather provider key if you use WeatherAPI instead of OpenWeatherMap.
WEATHERAPI_KEY=""

# WEATHER_API_KEY: Generic weather API key alias (supports OpenWeatherMap or WeatherAPI keys).
WEATHER_API_KEY=""
